{
  "name": "@jawfish/pi-code-execution",
  "version": "0.1.0",
  "description": "Run CPython scripts as a Pi tool",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/jawfish/pi-code-execution#readme",
  "bugs": {
    "url": "https://github.com/jawfish/pi-code-execution/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jawfish/pi-code-execution.git"
  },
  "files": [
    "artifacts.ts",
    "context.ts",
    "core.ts",
    "diagnostics.ts",
    "host.ts",
    "index.ts",
    "launcher.ts",
    "rendering.ts",
    "runner.ts"
  ],
  "os": [
    "!win32"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./host": "./host.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typebox": "^1.2.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
